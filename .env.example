# Copy to .env in this repository root and fill only variables you need.
# Existing shell exports take precedence. .env is ignored; never commit credentials.

# Approved Hugging Face account: gated dataset and model checkpoints.
HF_TOKEN=

# Use the same key in vLLM server and generation-client environments.
VLLM_API_KEY=

# Native Gemini generation (GOOGLE_API_KEY is a fallback when GEMINI_API_KEY is empty).
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Question/response judging and Batch inspection/cancellation.
OPENAI_API_KEY=

# Fireworks/OpenRouter access profiles; generation adapters are not implemented yet.
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=

# Optional GPU/model-cache settings inherited by vLLM and Hugging Face.
# CUDA_VISIBLE_DEVICES=0,1
# HF_HOME=/absolute/path/to/huggingface-cache
# HF_HUB_CACHE=/absolute/path/to/huggingface-cache/hub

# Optional report-rendering cache (use a writable location).
# MPLCONFIGDIR=/absolute/path/to/matplotlib-cache

# Optional launcher/log settings; omit to use the active Python and repo logs/.
# PYTHON_BIN=/absolute/path/to/eval-env/bin/python
# PIPELINE_LOG_DIR=/absolute/path/to/logs
# PIPELINE_LOG_RUN_ID=experiment_20261014
# PIPELINE_LOG_MODEL=my-model
